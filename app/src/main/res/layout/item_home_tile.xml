<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tile_card"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <!-- Icon -->
        <ImageView
            android:id="@+id/tile_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="8dp"
            app:tint="@color/text_on_primary"/>

        <!-- Title -->
        <TextView
            android:id="@+id/tile_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today's Classes"
            android:textColor="@color/text_on_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:gravity="center"/>

        <!-- Content -->
        <TextView
            android:id="@+id/tile_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mobile App - 9:00 AM"
            android:textColor="@color/text_on_primary"
            android:textSize="12sp"
            android:gravity="center"/>

        <!-- Additional Info -->
        <TextView
            android:id="@+id/tile_additional_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room: B101"
            android:textColor="@color/text_on_primary"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:gravity="center"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>