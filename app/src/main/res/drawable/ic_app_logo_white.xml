<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background: Rounded White Rectangle -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white"/>
            <corners android:radius="22dp"/> <!-- Soft rounded corners -->
        </shape>
    </item>
    
    <!-- Logo: Centered and smaller (padded from edges) -->
    <item 
        android:drawable="@drawable/logoo"
        android:gravity="center"
        android:top="20dp"
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        />
</layer-list>
